<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora orb — matches OrbSkin.Aurora / AuraOrb. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft cyan halo -->
    <path android:pathData="M54,54m-40,0a40,40 0,1 1,80 0a40,40 0,1 1,-80 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="40">
                <item
                    android:offset="0"
                    android:color="#994DE8FF" />
                <item
                    android:offset="0.55"
                    android:color="#334DE8FF" />
                <item
                    android:offset="1"
                    android:color="#004DE8FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sphere — light source upper-left (≈34%/28%) -->
    <path android:pathData="M54,54m-26,0a26,26 0,1 1,52 0a26,26 0,1 1,-52 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="45.2"
                android:centerY="42.7"
                android:gradientRadius="50.7">
                <item
                    android:offset="0"
                    android:color="#FF7EF2FF" />
                <item
                    android:offset="0.56"
                    android:color="#FF6B4DFF" />
                <item
                    android:offset="1"
                    android:color="#FF2A1361" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Rim light so the sphere doesn't read flat -->
    <path android:pathData="M54,54m-26,0a26,26 0,1 1,52 0a26,26 0,1 1,-52 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="26">
                <item
                    android:offset="0.72"
                    android:color="#00FFFFFF" />
                <item
                    android:offset="1"
                    android:color="#28FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
