## Copy to local.properties (gitignored) and fill in values.
sdk.dir=/path/to/Android/Sdk

# TODO: Move API keys behind a server-side proxy before any real distribution.
# Do not commit real keys. Client-side keys are only for local development.
#
# After changing keys: rebuild the APK (BuildConfig is generated at compile time).
#   ./gradlew :app:assembleDebug

# Provider selection: auto | local | openrouter | anthropic | openai
# auto tries: local → openrouter → anthropic → openai (skips unconfigured)
LLM_PROVIDER=auto

# Local OpenAI-compatible server (Ollama / LM Studio / vLLM)
# Phone via USB: adb reverse tcp:11434 tcp:11434  then use http://127.0.0.1:11434/v1
# Emulator: http://10.0.2.2:11434/v1
# Same Wi‑Fi LAN: http://192.168.x.x:11434/v1
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=llama3.2
LOCAL_LLM_API_KEY=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
