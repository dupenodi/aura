## Copy to local.properties (gitignored) and fill in values.
sdk.dir=C:\\Users\\YOUR_USER\\AppData\\Local\\Android\\Sdk

# TODO: Move API keys behind a server-side proxy before any real distribution.
# Do not commit real keys. Client-side keys are only for local development.
#
# After changing keys: rebuild the APK (BuildConfig is generated at compile time).
#   ./gradlew :app:assembleDebug

OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Preferred for STT (Saaras v3) + TTS (Bulbul v3). Falls back to Deepgram → OpenAI.
SARVAM_API_KEY=your-sarvam-key-here

# Secondary for STT (Nova-2) + TTS (Aura). Falls back to OpenAI if missing/fails.
DEEPGRAM_API_KEY=your-deepgram-key-here
